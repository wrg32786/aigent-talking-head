{
 "source": {
  "repo": "https://github.com/Vibha-Ramprakash/claude-video-effects",
  "author": "Vibha Ramprakash",
  "license": "MIT",
  "note": "Starter effects. Every effect gets face tracking and a person cut-out; \"face\" in needs means it is placed relative to the face, \"segmentation\" means it hides behind you."
 },
 "captionZone": {
  "captionY": 1300,
  "band": [
   0.6,
   0.78
  ],
  "rule": "captions are composited after the effects, so camera moves never zoom them; \"off\" effects hide captions for their window automatically; \"check\" effects need a check frame"
 },
 "pacing": {
  "maxHighEnergyEvery": 5,
  "hookWithin": 2,
  "ctaAtEnd": true,
  "perReel": [
   3,
   6
  ]
 },
 "moments": {
  "hook": "First 2 s. Stop the scroll.",
  "claim": "The key promise or bold statement.",
  "list": "Steps, features, a numbered list.",
  "reveal": "The turn: \"here is the thing\", the answer.",
  "proof": "A number, a result, social proof.",
  "objection": "\"But...\"/\"No...\", myth-busting, what not to do.",
  "cta": "The ask at the end: comment, follow, link.",
  "transition": "Between sections or at a seam."
 },
 "energy": {
  "calm": "grades, slow moves, quiet panels",
  "medium": "pops, cards, words",
  "high": "punch-ins, stamps, glitches, busy card storms"
 },
 "effects": [
  {
   "n": 1,
