{
  "name": "aigent-talking-head",
  "private": true,
  "version": "1.2.0",
  "description": "Talking-head video pipeline: raw footage or HeyGen takes to a captioned, themed 9:16 reel.",
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "reel": "node kit/reel.cjs",
    "smoke": "node kit/smoke.mjs",
    "smoke:whisper": "node kit/smoke.mjs --whisper",
    "check": "node kit/check.mjs",
    "menu": "node kit/menu.mjs",
    "showcase": "node kit/showcase.mjs",
    "preset": "node kit/preset.cjs",
    "brand:import": "node kit/brand-import.mjs",
    "verify": "node kit/verify.mjs",
    "chrome": "node kit/chrome.mjs",
    "fx": "node kit/fx.cjs",
    "effects:setup": "node effects/setup.mjs",
    "effects:update": "node effects/update.mjs",
    "effects:check": "node effects/check.mjs",
    "effects:catalog": "node effects/catalog.mjs",
    "smoke:effects": "node kit/smoke.mjs --effects",
    "music": "node kit/music/add.mjs",
    "music:add": "node kit/music/add.mjs",
    "fonts:examples": "node kit/fonts/examples.mjs",
    "reelmd": "node kit/reelmd.cjs",
    "teardown": "node kit/teardown.mjs",
    "capture": "node kit/capture.mjs",
    "contract": "node kit/contract.mjs"
  },
  "dependencies": {
    "playwright-core": "^1.47.0"
  },
  "license": "Apache-2.0"
}
